# Server port (default: 3000)
PORT=3000

# Session secret — replace with a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-secure-random-string

# Default admin credentials used by the seed script (npm run seed)
# Change these after first login
SEED_ADMIN_EMAIL=admin@acme-corp.example
SEED_ADMIN_PASSWORD=Admin1234!

# Default password assigned to sample users created by the seed script
SEED_USER_PASSWORD=Sample1234
